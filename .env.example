# Copy to .env and adjust for your environment.

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=civic_radar
POSTGRES_USER=civic_radar
POSTGRES_PASSWORD=civic_radar_dev_password
DATABASE_URL=postgresql+psycopg://civic_radar:civic_radar_dev_password@postgres:5432/civic_radar

# --- Archive ---
# Path inside containers where raw source material is stored.
ARCHIVE_ROOT=/archive

# --- Ollama (local AI) ---
# Point at the native Ollama on madhatter (the target deployment server) or
# the docker-compose `ollama` service (http://ollama:11434), whichever this
# environment actually has models pulled into.
OLLAMA_BASE_URL=http://madhatter.local:11434
# gpt-oss:20b produced garbled output when tested against madhatter (see
# README known-issues) -- confirm a model actually works before relying on it.
OLLAMA_TRIAGE_MODEL=llama3.1:8b
OLLAMA_ANALYSIS_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# If Ollama is unreachable or the models above aren't pulled yet, the worker
# logs the failure to ai_outputs.error_message and continues rather than
# crashing the pipeline (see prd.md "AI Guardrails" / reliability requirements).

# --- WhisperX (meeting audio transcription + speaker diarization) ---
# A separate GPU-bound service (whisperx_service/), not bundled into the
# worker container -- same reasoning as Ollama running standalone. Runs on
# madhatter; see whisperx_service/README.md to deploy.
WHISPERX_BASE_URL=http://madhatter.local:8091

# --- Worker ---
# How often the scheduler wakes up to check which sources are due for a fetch.
WORKER_TICK_SECONDS=60
# Cap on concurrent AI jobs, per prd.md 20.3 resource constraints.
AI_JOB_CONCURRENCY=1
HTTP_USER_AGENT=VenturaCivicRadar/0.1 (+local civic monitoring; contact: mark.gibbs@gmail.com)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
